             RowBox[{"Tmin", "/", "1.4"}], ",", "0", ",", "0"}], "]"}]}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tCPU1", "=", 
        RowBox[{"TimeUsed", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Solve", " ", "the", " ", "ODE", " ", "system"}], " ", "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"solEarlyUniverset", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", " ", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"T\[Gamma]", "'"}], "[", "t", "]"}], "\[Equal]", 
             RowBox[{"dT\[Gamma]dt", "[", 
              RowBox[{
               RowBox[{"T\[Gamma]", "[", "t", "]"}], ",", 
               RowBox[{"T\[Nu]", "[", "t", "]"}], ",", 
               RowBox[{"T\[Nu]", "[", "t", "]"}], ",", "0", ",", "0"}], 
              "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"T\[Nu]", "'"}], "[", "t", "]"}], "\[Equal]", 
             RowBox[{"dT\[Nu]dt", "[", 
              RowBox[{
               RowBox[{"T\[Gamma]", "[", "t", "]"}], ",", 
               RowBox[{"T\[Nu]", "[", "t", "]"}], ",", 
               RowBox[{"T\[Nu]", "[", "t", "]"}], ",", "0", ",", "0"}], 
              "]"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"aT\[Nu]", "'"}], "[", "t", "]"}], "\[Equal]", 
