              FractionBox[
               RowBox[{"aT\[Nu]", "[", "t", "]"}], 
               RowBox[{"T\[Nu]", "[", "t", "]"}]], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"dT\[Nu]dt", "[", 
                 RowBox[{
                  RowBox[{"T\[Gamma]", "[", "t", "]"}], ",", 
                  RowBox[{"T\[Nu]", "[", "t", "]"}], ",", 
                  RowBox[{"T\[Nu]", "[", "t", "]"}], ",", "0", ",", "0"}], 
                 "]"}], "+", 
