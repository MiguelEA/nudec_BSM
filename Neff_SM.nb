    " ", 
    RowBox[{
    "the", " ", "QED", " ", "corrections", " ", "will", " ", "be", " ", "set",
      " ", "to", " ", "0"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
