Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"orderQED", "=", "3"}], ";"}], " ", "\[IndentingNewLine]", " ", 
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "QED", " ", "corrections", " ", "are", " ", "coded", " ", "up", " ", "to",
      " ", "O", 
     RowBox[{"(", 
      SuperscriptBox["e", "5"], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "the", " ", "default", " ", "is", " ", "3", " ", "without", " ", 
      "momentum", " ", "dependent", " ", "contributions", " ", "at", " ", "O", 
      RowBox[{"(", 
       SuperscriptBox["e", "2"], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"orderQED", "=", 
      RowBox[{"2", " ", ":", " ", 
       RowBox[{"O", 
        RowBox[{"(", 
         SuperscriptBox["e", "2"], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"orderQED", "=", 
      RowBox[{"3", " ", ":", " ", 
       RowBox[{"O", 
        RowBox[{"(", 
         SuperscriptBox["e", "3"], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"orderQED", "=", 
      RowBox[{"4", " ", ":", " ", 
       RowBox[{"O", 
        RowBox[{"(", 
         SuperscriptBox["e", "4"], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"orderQED", "=", 
      RowBox[{"5", " ", ":", " ", 
       RowBox[{"O", 
        RowBox[{"(", 
         SuperscriptBox["e", "5"], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"orderQED", "=", 
      RowBox[{"6", " ", ":", " ", 
       RowBox[{
        RowBox[{"O", 
         RowBox[{"(", 
          SuperscriptBox["e", "5"], ")"}]}], " ", "+", " ", 
        RowBox[{
        "momentum", " ", "dependent", " ", "piece", " ", "at", "  ", "O", 
         RowBox[{"(", 
          SuperscriptBox["e", "2"], ")"}]}]}]}]}], ";", " ", "Else"}], ",", 
    " ", 
    RowBox[{
    "the", " ", "QED", " ", "corrections", " ", "will", " ", "be", " ", "set",
      " ", "to", " ", "0"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "If", " ", "you", " ", "are", " ", "not", " ", "modifying", " ", "the", 
    " ", "value", " ", "of", " ", "the", " ", "electron", " ", "mass", " ", 
    "or", " ", "the", " ", "value", " ", "of", " ", "\[Alpha]", " ", "we", 
    " ", "strongly", " ", "recommend", " ", "simply", " ", "loading", " ", 
    "the", " ", "file"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flagQED", "=", "\"\<FILE\>\""}], ";"}], "\[IndentingNewLine]", 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Default", " ", "and", " ", 
     RowBox[{"recommended", ":", " ", "\"\<FILE\>\""}]}], " ", ";", " ", 
    RowBox[{
     RowBox[{"--", " ", "If"}], " ", "you", " ", "are", " ", "not", " ", 
     "modifying", " ", "the", " ", "value", " ", "of", " ", "me", " ", "or", 
     " ", "\[Alpha]", " ", "it", " ", "is", " ", "highly", " ", 
     "recommended"}], ";", "\[IndentingNewLine]", "            ", 
    RowBox[{"other", " ", 
     RowBox[{"options", " ", ":", " ", 
      RowBox[{"\"\<BESSEL\>\"", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"using", " ", "Bessel", " ", "functions"}], ",", " ", 
          RowBox[{"orderQED", "=", 
           RowBox[{"6", " ", "does", " ", "not", " ", "work"}]}]}], ")"}], 
        "."}]}]}]}], ";", "\[IndentingNewLine]", 
    "                                      ", 
    RowBox[{
     RowBox[{
     "If", " ", "chosen", " ", "you", " ", "can", " ", "also", " ", "play", 
      " ", "with", " ", "the", " ", 
      RowBox[{"order", ":", " ", "nBesselmaxQED"}]}], " ", "=", " ", 
     RowBox[{
     "30.", "\[IndentingNewLine]", "                        ", ":", " ", 
      RowBox[{"\"\<FULL\>\"", "   ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"not", " ", "recommended"}], ",", " ", 
         RowBox[{
         "as", " ", "it", " ", "uses", " ", "numerical", " ", "integration", 
          " ", "which", " ", "is", " ", "extremely", " ", "costly"}]}], 
        ")"}]}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"flagthermo", "=", "\"\<BESSEL\>\""}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nBesselmaxBSM", "=", "30"}], ";"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Default", " ", "and", " ", 
     RowBox[{"recommended", ":", " ", 
      RowBox[{"\"\<BESSEL\>\"", " ", 
       RowBox[{"(", 
        RowBox[{
        "this", " ", "is", " ", "highly", " ", "recommended", " ", "as", " ", 
         "it", " ", "speeds", " ", "up", " ", "the", " ", "calculaion", " ", 
         "by", " ", "a", " ", "factor", " ", "of", " ", "10"}], ")"}]}]}]}], 
    ";", "\[IndentingNewLine]", "\t\t\t\t\t\t\t\t\t ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"if", " ", "chosen"}], ",", " ", 
      RowBox[{
       RowBox[{
       "then", " ", "one", " ", "can", " ", "set", " ", "up", " ", "the", " ",
         "order", " ", "of", " ", "Bessel", " ", "functions", " ", 
        "nBesselmaxBSM"}], "=", " ", "30"}]}], ")"}], ";", 
    "\[IndentingNewLine]", "              ", 
    RowBox[{"other", " ", 
     RowBox[{"option", ":", " ", 
      RowBox[{"\"\<FULL\>\"", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"recommended", " ", "only", " ", "if", " ", 
          RowBox[{"\[Mu]", "/", "T"}]}], " ", ">", " ", 
         RowBox[{"0.1", " ", "for", " ", "some", " ", "reason"}]}], 
