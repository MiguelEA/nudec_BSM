                 RowBox[{"T\[Nu]", "[", "t", "]"}], 
                 RowBox[{"Hubble", "[", 
                  RowBox[{
                   RowBox[{"T\[Gamma]", "[", "t", "]"}], ",", 
                   RowBox[{"T\[Nu]", "[", "t", "]"}], ",", 
                   RowBox[{"T\[Nu]", "[", "t", "]"}], ",", "0", ",", "0"}], 
                  "]"}]}]}], ")"}]}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"aT\[Gamma]", "'"}], "[", "t", "]"}], "\[Equal]", 
