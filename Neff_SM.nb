Cell[BoxData[
 RowBox[{"ListLogLogPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["10", "tval"], ",", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Rho]tot", "[", 
               RowBox[{
                RowBox[{"T\[Gamma]", "[", "t", "]"}], ",", 
                RowBox[{"T\[Nu]e", "[", "t", "]"}], ",", 
                RowBox[{"T\[Nu]\[Mu]", "[", "t", "]"}], ",", 
                RowBox[{"\[Mu]\[Nu]e", "[", "t", "]"}], ",", 
                RowBox[{"\[Mu]\[Nu]\[Mu]", "[", "t", "]"}]}], "]"}], ",", 
              "t"}], "]"}], 
            RowBox[{"RHSec", "[", 
             RowBox[{
              RowBox[{"T\[Gamma]", "[", "t", "]"}], ",", 
              RowBox[{"T\[Nu]e", "[", "t", "]"}], ",", 
              RowBox[{"T\[Nu]\[Mu]", "[", "t", "]"}], ",", 
              RowBox[{"\[Mu]\[Nu]e", "[", "t", "]"}], ",", 
              RowBox[{"\[Mu]\[Nu]\[Mu]", "[", "t", "]"}]}], "]"}]]}], "/.", 
          RowBox[{"First", "[", "solEarlyUniverset", "]"}]}], "]"}], "/.", 
        RowBox[{"t", "->", 
         SuperscriptBox["10", "tval"]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"tval", ",", 
       RowBox[{"-", "2"}], ",", "2", ",", "0.05"}], "}"}]}], "]"}], ",", 
